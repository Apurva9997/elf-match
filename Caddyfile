# https://elfmatch.com. A copy you run yourself replaces both hostnames.
www.elfmatch.com {
	redir https://elfmatch.com{uri} permanent
}

elfmatch.com {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
	reverse_proxy elfmatch:3000
}
