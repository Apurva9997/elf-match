# Copy to packages/web/.env.local. Do not commit that file.

# Postgres you control. Neon: use the pooled host (the one with -pooler).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/elfmatch?sslmode=require

# Clerk → API keys. The publishable key is public. The secret key is not.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/login
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Origin of this app. Invite links and CORS use it.
FRONTEND_URL=http://localhost:3000

# Generate three different values. Losing one makes its data unreadable.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ENCRYPTION_SECRET=replace-with-32-or-more-random-characters
ENCRYPTION_SALT=replace-with-another-random-value
WISHLIST_SEAL_KEY=replace-with-a-third-random-value

# Set to true only after Google is turned on in your Clerk application.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

# Optional. Unset means the feature is off.
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mg.example.com
# FROM_EMAIL=noreply@example.com
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# SENTRY_DSN=
