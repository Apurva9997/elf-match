# API URL — set to the Netlify API site URL in production
NEXT_PUBLIC_API_URL=http://localhost:8888

# Clerk Authentication (get these from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Clerk redirect paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Google OAuth (enabled by default)
# Set to "false" to disable Google Sign-In button
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=true

# Apple OAuth (disabled by default)
# Set to "true" to enable Apple Sign-In button
# NEXT_PUBLIC_APPLE_OAUTH_ENABLED=false
