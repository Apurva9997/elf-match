# Set this to the Netlify URL of the deployed API site
# e.g. https://api.giftwhisper.online or https://your-api-site.netlify.app
NEXT_PUBLIC_API_URL=https://apis.giftwhisper.online

# Clerk redirect paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
