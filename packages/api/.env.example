# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/secret_santa

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Encryption (for sensitive data like addresses)
ENCRYPTION_SECRET=your-32-character-encryption-secret-key
ENCRYPTION_SALT=your-custom-salt-value-here

# Frontend URL (used for email links and CORS)
FRONTEND_URL=http://localhost:3000
# Production: FRONTEND_URL=https://elfmatch.com

# Email Configuration (Mailgun)
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.example.com
FROM_EMAIL=noreply@example.com

# Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Sentry Error Tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
