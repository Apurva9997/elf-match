# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/secret_santa

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# Encryption (for sensitive data like addresses)
ENCRYPTION_SECRET=your-32-character-encryption-secret-key
ENCRYPTION_SALT=secret-santa-salt-v1

# Frontend URL (used for email links and CORS)
FRONTEND_URL=http://localhost:3000
# Production: FRONTEND_URL=https://giftwhisper.online

# Email Configuration (Resend)
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=info@giftwhisper.online

# Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Sentry Error Tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================
# OAuth Configuration
# ============================================

# Google OAuth (Required for Google Sign-In)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google
# Production: GOOGLE_REDIRECT_URI=https://giftwhisper.online/auth/callback/google

# Apple OAuth (Optional - disabled by default)
# APPLE_CLIENT_ID=your-apple-services-id
# APPLE_TEAM_ID=your-apple-team-id
# APPLE_KEY_ID=your-apple-key-id
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APPLE_REDIRECT_URI=http://localhost:3000/auth/callback/apple
# Production: APPLE_REDIRECT_URI=https://giftwhisper.online/auth/callback/apple
