# Database
DATABASE_URL=postgres://user:password@localhost:5432/secret_santa

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Encryption (for sensitive data like addresses)
ENCRYPTION_SECRET=your-encryption-secret-min-32-chars
ENCRYPTION_SALT=secret-santa-salt-v1

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Email (AWS SES - only used in production, dev mode logs to console)
SES_FROM_EMAIL=noreply@secretsanta.app
AWS_REGION=ap-south-1

# Stage (dev|prod)
STAGE=dev

# Upstash
UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-token"