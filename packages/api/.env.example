# Used by drizzle-kit, which reads this directory. Same URL as packages/web/.env.local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/elfmatch?sslmode=require

# The running app reads packages/web/.env.local, not this file.
CLERK_SECRET_KEY=sk_test_your_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

ENCRYPTION_SECRET=replace-with-32-or-more-random-characters
ENCRYPTION_SALT=replace-with-another-random-value
WISHLIST_SEAL_KEY=replace-with-a-third-random-value

FRONTEND_URL=http://localhost:3000
# The live site is https://elfmatch.com. A copy you run sets its own origin.

# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mg.example.com
# FROM_EMAIL=noreply@example.com
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
