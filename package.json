{
  "name": "secret-santa",
  "version": "1.0.0",
  "private": true,
  "description": "A modern Secret Santa gift exchange platform",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @secret-santa/api dev",
    "dev:web": "pnpm --filter @secret-santa/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @secret-santa/api db:generate",
    "db:migrate": "pnpm --filter @secret-santa/api db:migrate",
    "db:push": "pnpm --filter @secret-santa/api db:push",
    "db:studio": "pnpm --filter @secret-santa/api db:studio"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
